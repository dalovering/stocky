# Copy this file to .env (or run `make init-env`) and fill in real values.
# NEVER commit .env.

# ---- Database (PostgreSQL 18 — do not downgrade) ----
# These components are the SINGLE SOURCE OF TRUTH for the DB credentials. The backend
# assembles the async connection URL from them (see backend/app/core/config.py), so the
# password is not duplicated anywhere.
POSTGRES_USER=stocky
POSTGRES_PASSWORD=stocky_dev_password
POSTGRES_DB=stocky
# Host for commands run on your machine (make dev / migrate / seed). docker-compose
# overrides this to `db` inside the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: set this only to point at an external/managed database. When set it overrides
# the POSTGRES_* components above. Must be an async DSN, e.g.:
#   DATABASE_URL_OVERRIDE=postgresql+asyncpg://user:pass@host:5432/dbname
# DATABASE_URL_OVERRIDE=

# ---- Backend auth ----
# The admin password itself is NOT set here — it's configured in-app on first launch (the
# Administration views prompt for a password to set up the first time there isn't one yet).
# Secret used to sign the admin session JWT. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# How long an admin session stays valid (minutes).
JWT_EXPIRE_MINUTES=480

# CORS / frontend origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000

# ---- Frontend ----
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- Label printer (Nelko PM220, optional) ----
# Device node the backend writes raw TSPL to. Leave unset if no printer is attached.
#   Pi over USB:        PRINTER_DEVICE=/dev/usb/lp0
#   Pi over Bluetooth:  PRINTER_DEVICE=/dev/rfcomm0   (after `rfcomm bind`)
#   macOS (make dev):   PRINTER_DEVICE=/dev/cu.PM220_xxxx  (Bluetooth serial; macOS has
#                       no raw USB printer node — pair over Bluetooth to test locally)
# PRINTER_DEVICE=
# "auto" picks serial for tty nodes, raw char device otherwise. Or force: usb | serial.
# PRINTER_TRANSPORT=auto
# PRINTER_BAUD=115200
# TSPL BITMAP mode: 1 (spec OR-mode, default) or 3 (PM220-specific; try if output is garbled).
# PRINTER_BITMAP_MODE=1
# Optional TTF for label text (wider charset than the built-in Latin-1 font).
# LABEL_FONT_PATH=

# On the Pi, also enable container device access (see docker-compose.printer.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.printer.yml
# Host gid of the `lp` group (`getent group lp | cut -d: -f3`; 7 on Raspberry Pi OS):
# PRINTER_GID=7
