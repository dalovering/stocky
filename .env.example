# Copy this file to .env and fill in real values. NEVER commit .env.

# ---- Database (PostgreSQL 18 — do not downgrade) ----
POSTGRES_USER=stocky
POSTGRES_PASSWORD=stocky_dev_password
POSTGRES_DB=stocky
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async URL used by the FastAPI app (asyncpg driver).
# For local `make dev` (no docker) use POSTGRES_HOST=localhost.
DATABASE_URL=postgresql+asyncpg://stocky:stocky_dev_password@db:5432/stocky

# ---- Backend auth ----
# Password required to access the Administration views.
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session JWT. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# How long an admin session stays valid (minutes).
JWT_EXPIRE_MINUTES=480

# CORS / frontend origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000

# ---- Frontend ----
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE=http://localhost:8000
