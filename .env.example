# Copy this file to .env (or run `make init-env`) and fill in real values.
# NEVER commit .env.

# ---- Database (PostgreSQL 18 — do not downgrade) ----
# These components are the SINGLE SOURCE OF TRUTH for the DB credentials. The backend
# assembles the async connection URL from them (see backend/app/core/config.py), so the
# password is not duplicated anywhere.
POSTGRES_USER=stocky
POSTGRES_PASSWORD=stocky_dev_password
POSTGRES_DB=stocky
# Host for commands run on your machine (make dev / migrate / seed). docker-compose
# overrides this to `db` inside the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: set this only to point at an external/managed database. When set it overrides
# the POSTGRES_* components above. Must be an async DSN, e.g.:
#   DATABASE_URL_OVERRIDE=postgresql+asyncpg://user:pass@host:5432/dbname
# DATABASE_URL_OVERRIDE=

# ---- Backend auth ----
# The admin password itself is NOT set here — it's configured in-app on first launch (the
# Administration views prompt for a password to set up the first time there isn't one yet).
# Secret used to sign the admin session JWT. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# How long an admin session stays valid (minutes).
JWT_EXPIRE_MINUTES=480

# CORS / frontend origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000

# ---- Frontend ----
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE=http://localhost:8000
