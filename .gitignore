# ---- Environment / secrets ----
.env
.env.local
*.local
scratch/
tmp/

# ---- Real data (never commit) ----
# Stocky imports/exports users and items as spreadsheets, and those contain real student
# names. This repo is public and git history is permanent — an accidental `git add` of an
# export cannot be undone by deleting the file later. The tests build their workbooks in
# memory (openpyxl), so nothing here needs a committed fixture; if that ever changes, add
# the one file deliberately with `git add -f`.
*.xlsx
*.xls
*.csv

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

